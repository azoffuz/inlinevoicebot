# Telegram Bot sozlamalari
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Supabase sozlamalari (Project Settings -> API dan olinadi)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Storage sifatida ishlatiladigan Telegram kanal ID si (masalan: -1001234567890)
# Bot ushbu kanalga admin qilib qo'shilishi shart!
STORAGE_CHANNEL_ID=-1001234567890

# Forum Topics (Mavzular) ochiladigan Admin Guruh ID si (masalan: -1009876543210)
ADMIN_GROUP_ID=-1009876543210

# Bosh Superadmin Telegram user_id si
SUPERADMIN_ID=123456789


# Render.com yoki mahalliy port (Health check server uchun)
PORT=8080
